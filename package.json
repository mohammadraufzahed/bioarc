{
  "name": "@bioarc/omp-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Repository-aware OMP extension for Bioarc Turborepo workspaces",
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "dist",
    "defaults",
    "README.md",
    "POLICY.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "npm run build && node --test"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.2"
  }
}
